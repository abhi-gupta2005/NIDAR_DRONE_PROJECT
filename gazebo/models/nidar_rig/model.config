<?xml version="1.0"?>
<model>
  <name>nidar_rig</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>NIDAR AirMouse</name></author>
  <description>
    Sensor rig without PX4 (2026-11-02): the same camera and LiDAR as
    x500_nidar_airmouse on a floating body with gravity off, moved by
    VelocityControl (/model/nidar_rig/cmd_vel, body frame) and reporting
    ground truth with OdometryPublisher (/model/nidar_rig/odometry).
    For perception / fusion / SLAM tests along a known path. Not a flight model.
  </description>
</model>
