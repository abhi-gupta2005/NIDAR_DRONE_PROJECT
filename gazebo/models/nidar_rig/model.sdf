<?xml version="1.0" encoding="UTF-8"?>
<!--
  NIDAR sensor rig (2026-11-02c) - perception/mapping test carrier WITHOUT PX4.
  Looks like the PX4 x500 (same meshes, model://x500_base) but has no motors,
  no flight controller and no gravity: VelocityControl moves it, OdometryPublisher
  reports ground truth. gazebo/ros2/nidar_rig_driver.py drives it.

  Frame: x forward, y left, z up. The link origin IS the LiDAR scan plane
  (spawn z = LiDAR height). Geometry matches x500_nidar_airmouse:
    LiDAR   0.12 m above the x500 base_link (rig origin)
    camera  0.18 m below the LiDAR, 0.15 m forward, 70 deg HFOV
  Every visual stays below the scan plane: the first version had an orange
  nose block at 0.15-0.19 m forward IN the plane and the LiDAR saw it as an
  obstacle at 0.16 m straight ahead (2026-11-02, check_scan_vs_truth.py).
  The x500 frame mesh tops out 0.051 m above base_link (measured from
  NXP-HGD-CF.dae), the props at ~0.06 m: >= 0.06 m below the plane.
  Topics: camera /nidar/camera/image, LiDAR /nidar/scan.

  2026-11-02g "ABHISHEK DRONE" livery: blue frame, silver motor bases, red motor
  bells, orange FRONT props / dark rear props, red (left) and green (right)
  navigation lights, and a red name plate (materials/textures/abhishek_drone_plate.png)
  behind the LiDAR. Colours and the plate/lights only: every new visual is a
  primitive well below the scan plane (tests/test_gazebo_models.py), sensors and
  geometry are unchanged. run_rig.sh spawns it as "abhishek_drone"; the motion and
  odometry topics stay /model/nidar_rig/* (pinned below) so the bridge and the rig
  driver are unchanged.
-->
<sdf version="1.9">
  <model name="nidar_rig">
    <static>false</static>
    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia>
      </inertial>

      <visual name="x500_frame">
        <pose>0 0 -0.095 0 0 3.141592654</pose>
        <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/NXP-HGD-CF.dae</uri></mesh></geometry>
        <material><ambient>0.06 0.18 0.48 1</ambient><diffuse>0.08 0.25 0.65 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <visual name="x500_motor_base_0">
        <pose>0.174 0.174 -0.088 0 0 -0.45</pose>
        <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="x500_motor_base_1">
        <pose>-0.174 0.174 -0.088 0 0 -0.45</pose>
        <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="x500_motor_base_2">
        <pose>0.174 -0.174 -0.088 0 0 -0.45</pose>
        <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="x500_motor_base_3">
        <pose>-0.174 -0.174 -0.088 0 0 -0.45</pose>
        <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="x500_rotor_0_prop">
        <pose>0.152 -0.3204 -0.076 0 0 0</pose>
        <geometry><mesh><scale>0.8461538461538461 0.8461538461538461 0.8461538461538461</scale><uri>model://x500_base/meshes/1345_prop_ccw.stl</uri></mesh></geometry>
        <material><ambient>0.75 0.4 0.05 1</ambient><diffuse>0.98 0.55 0.10 1</diffuse></material>
      </visual>
      <visual name="x500_rotor_0_bell">
        <pose>0.174 -0.174 -0.092 0 0 0</pose>
        <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Bell.dae</uri></mesh></geometry>
        <material><ambient>0.6 0.08 0.08 1</ambient><diffuse>0.85 0.12 0.12 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
      </visual>
      <visual name="x500_rotor_1_prop">
        <pose>-0.196 0.0276 -0.076 0 0 0</pose>
        <geometry><mesh><scale>0.8461538461538461 0.8461538461538461 0.8461538461538461</scale><uri>model://x500_base/meshes/1345_prop_ccw.stl</uri></mesh></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.14 0.14 0.14 1</diffuse></material>
      </visual>
      <visual name="x500_rotor_1_bell">
        <pose>-0.174 0.174 -0.092 0 0 0</pose>
        <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Bell.dae</uri></mesh></geometry>
        <material><ambient>0.6 0.08 0.08 1</ambient><diffuse>0.85 0.12 0.12 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
      </visual>
      <visual name="x500_rotor_2_prop">
        <pose>0.152 0.0276 -0.076 0 0 0</pose>
        <geometry><mesh><scale>0.8461538461538461 0.8461538461538461 0.8461538461538461</scale><uri>model://x500_base/meshes/1345_prop_cw.stl</uri></mesh></geometry>
        <material><ambient>0.75 0.4 0.05 1</ambient><diffuse>0.98 0.55 0.10 1</diffuse></material>
      </visual>
      <visual name="x500_rotor_2_bell">
        <pose>0.174 0.174 -0.092 0 0 0</pose>
        <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Bell.dae</uri></mesh></geometry>
        <material><ambient>0.6 0.08 0.08 1</ambient><diffuse>0.85 0.12 0.12 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
      </visual>
      <visual name="x500_rotor_3_prop">
        <pose>-0.196 -0.3204 -0.076 0 0 0</pose>
        <geometry><mesh><scale>0.8461538461538461 0.8461538461538461 0.8461538461538461</scale><uri>model://x500_base/meshes/1345_prop_cw.stl</uri></mesh></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.14 0.14 0.14 1</diffuse></material>
      </visual>
      <visual name="x500_rotor_3_bell">
        <pose>-0.174 -0.174 -0.092 0 0 0</pose>
        <geometry><mesh><scale>1 1 1</scale><uri>model://x500_base/meshes/5010Bell.dae</uri></mesh></geometry>
        <material><ambient>0.6 0.08 0.08 1</ambient><diffuse>0.85 0.12 0.12 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
      </visual>
      <!-- LiDAR puck: below the scan plane (top at -0.005 m) -->
      <visual name="nidar_lidar_visual">
        <pose>0 0 -0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <!-- ABHISHEK DRONE name plate on the frame, behind the LiDAR puck (top at -0.038 m) -->
      <visual name="abhishek_name_plate">
        <pose>-0.085 0 -0.040 0 0 1.5708</pose>
        <geometry><box><size>0.17 0.045 0.004</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://nidar_rig/materials/textures/abhishek_drone_plate.png</albedo_map>
            <metalness>0.0</metalness><roughness>0.6</roughness></metal></pbr>
        </material>
      </visual>
      <!-- navigation lights under the front arms: red = left (port), green = right (starboard) -->
      <visual name="nav_light_left">
        <pose>0.174 0.174 -0.115 0 0 0</pose>
        <geometry><sphere><radius>0.012</radius></sphere></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0.1 0.1 1</diffuse><emissive>1 0 0 1</emissive></material>
      </visual>
      <visual name="nav_light_right">
        <pose>0.174 -0.174 -0.115 0 0 0</pose>
        <geometry><sphere><radius>0.012</radius></sphere></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0.1 1 0.2 1</diffuse><emissive>0 1 0.1 1</emissive></material>
      </visual>
      <!-- camera housing, just behind the camera's optical centre -->
      <visual name="nidar_camera_visual">
        <pose>0.13 0 -0.18 0 0 0</pose>
        <geometry><box><size>0.02 0.04 0.03</size></box></geometry>
        <material><ambient>0.9 0.4 0.0 1</ambient><diffuse>0.9 0.4 0.0 1</diffuse></material>
      </visual>

      <sensor name="nidar_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
        <topic>/nidar/scan</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>500</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.12902628</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>

      <sensor name="nidar_camera" type="camera">
        <pose>0.15 0 -0.18 0 0 0</pose>
        <topic>/nidar/camera/image</topic>
        <update_rate>15</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.2217305</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>40</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/nidar_rig/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/model/nidar_rig/odometry</odom_topic>
      <odom_frame>nidar_world</odom_frame>
      <robot_base_frame>abhishek_drone</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
