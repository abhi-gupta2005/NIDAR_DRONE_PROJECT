<?xml version="1.0"?>
<model>
  <name>x500_nidar_airmouse</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>NIDAR AirMouse</name></author>
  <description>
    PX4 x500 + forward camera (70 deg HFOV, 640x480, 15 Hz) + 360 deg 2D LiDAR
    matched to the STL-19P (500 samples, 10 Hz, 12 m). Sensor topics:
    /nidar/camera/image and /nidar/scan. Added 2026-11-02 (new model; the
    existing x500_nidar_indoor is not changed).
  </description>
</model>
