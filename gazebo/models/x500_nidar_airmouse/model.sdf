<?xml version="1.0" encoding="UTF-8"?>
<!--
  NIDAR AirMouse drone for PX4 SITL (2026-11-02).
  x500 airframe (PX4_SYS_AUTOSTART=4001) + the two NIDAR sensors.
  Poses are in the model frame (origin on the ground under the drone,
  base_link at z = 0.24 m, x forward, y left, z up) - the same convention
  PX4 uses in x500_mono_cam / x500_lidar_2d.

  Sensor topics are fixed (independent of world and instance name) so the
  same ros_gz_bridge config and WSL relays serve this drone and nidar_rig:
    camera : /nidar/camera/image   (gz.msgs.Image)
    LiDAR  : /nidar/scan           (gz.msgs.LaserScan)
  Spawn only ONE NIDAR model per world, or the topics collide.
-->
<sdf version="1.9">
  <model name="x500_nidar_airmouse">
    <include merge="true">
      <uri>x500</uri>
    </include>

    <!-- 360 deg 2D LiDAR, STL-19P-like. 12 cm above base_link: the x500 frame
         mesh tops out 5.1 cm above base_link (measured) and the props at ~6 cm,
         so nothing of the drone lies in the scan plane. -->
    <link name="nidar_lidar_link">
      <pose>0 0 0.36 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia>
      </inertial>
      <visual name="nidar_lidar_visual">
        <pose>0 0 -0.02 0 0 0</pose>  <!-- puck below the scan plane -->
        <geometry><cylinder><radius>0.025</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="nidar_lidar" type="gpu_lidar">
        <gz_frame_id>nidar_lidar_link</gz_frame_id>
        <topic>/nidar/scan</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>500</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.12902628</max_angle>
            </horizontal>
          </scan>
          <range>
            <!-- STL-19P minimum is 0.03 m; 0.15 m keeps returns from the drone's
                 own frame out of the scan. -->
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </link>
    <joint name="nidar_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>nidar_lidar_link</child>
    </joint>

    <!-- Forward camera, 70 deg HFOV = the value V18 assumes (CAMERA_HFOV_DEG).
         0.06 m below base_link: the propellers (0.10 m higher) stay out of the
         image and no frame-mesh vertex is inside its field of view (checked
         against NXP-HGD-CF.dae, 2026-11-02c). -->
    <link name="nidar_camera_link">
      <pose>0.15 0 0.18 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia>
      </inertial>
      <visual name="nidar_camera_visual">
        <pose>-0.02 0 0 0 0 0</pose>
        <geometry><box><size>0.02 0.04 0.03</size></box></geometry>
        <material><ambient>0.9 0.4 0.0 1</ambient><diffuse>0.9 0.4 0.0 1</diffuse></material>
      </visual>
      <sensor name="nidar_camera" type="camera">
        <gz_frame_id>nidar_camera_link</gz_frame_id>
        <topic>/nidar/camera/image</topic>
        <update_rate>15</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.2217305</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>40</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="nidar_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>nidar_camera_link</child>
    </joint>
  </model>
</sdf>
