#!/usr/bin/env python3

import math
import time

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy

from std_msgs.msg import Float32MultiArray

from px4_msgs.msg import (
    OffboardControlMode,
    TrajectorySetpoint,
    VehicleCommand,
    VehicleLocalPosition,
    VehicleAttitude,
)


# ============================================================
# SAFETY CONFIGURATION
# ============================================================

ALLOW_OFFBOARD = True
ALLOW_ARM = True

MAX_FORWARD = 0.25
MAX_LATERAL = 0.25
MAX_VERTICAL = 0.0

COMMAND_TIMEOUT = 0.75
PUBLISH_HZ = 10.0


class PX4AirMouseController(Node):

    def __init__(self):
        super().__init__('px4_setpoint_sim')

        px4_qos = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            history=HistoryPolicy.KEEP_LAST,
            depth=10
        )

        # ----------------------------------------------------
        # State
        # ----------------------------------------------------

        self.forward = 0.0
        self.lateral = 0.0
        self.vertical = 0.0
        self.command_valid = False

        self.heading = 0.0

        self.position_x = 0.0
        self.position_y = 0.0
        self.position_z = 0.0

        self.last_command_time = 0.0
        self.start_time = time.monotonic()

        self.offboard_requested = False
        self.arm_requested = False

        # ----------------------------------------------------
        # Subscribers
        # ----------------------------------------------------

        self.command_sub = self.create_subscription(
            Float32MultiArray,
            '/nidar/airmouse_command',
            self.command_callback,
            10
        )

        self.position_sub = self.create_subscription(
            VehicleLocalPosition,
            '/fmu/out/vehicle_local_position_v1',
            self.position_callback,
            px4_qos
        )

        self.attitude_sub = self.create_subscription(
            VehicleAttitude,
            '/fmu/out/vehicle_attitude',
            self.attitude_callback,
            px4_qos
        )

        # ----------------------------------------------------
        # PX4 publishers
        # ----------------------------------------------------

        self.offboard_mode_pub = self.create_publisher(
            OffboardControlMode,
            '/fmu/in/offboard_control_mode',
            10
        )

        self.trajectory_pub = self.create_publisher(
            TrajectorySetpoint,
            '/fmu/in/trajectory_setpoint',
            10
        )

        self.vehicle_command_pub = self.create_publisher(
            VehicleCommand,
            '/fmu/in/vehicle_command',
            10
        )

        # ----------------------------------------------------
        # Control timer
        # ----------------------------------------------------

        self.timer = self.create_timer(
            1.0 / PUBLISH_HZ,
            self.control_loop
        )

        self.get_logger().info(
            'PX4 AirMouse controlled SITL controller started'
        )

        self.get_logger().info(
            f'ALLOW_OFFBOARD = {ALLOW_OFFBOARD}'
        )

        self.get_logger().info(
            f'ALLOW_ARM = {ALLOW_ARM}'
        )

        self.get_logger().info(
            f'MAX HORIZONTAL SPEED = {MAX_FORWARD:.2f} m/s'
        )

        self.get_logger().info(
            'VERTICAL MOVEMENT = DISABLED'
        )

    # ========================================================
    # NIDAR COMMAND
    # ========================================================

    def command_callback(self, msg):

        if len(msg.data) < 4:
            self.set_zero_command()
            return

        forward = float(msg.data[0])
        lateral = float(msg.data[1])
        valid = float(msg.data[3]) > 0.5

        self.last_command_time = time.monotonic()

        if not valid:
            self.set_zero_command()
            return

        self.command_valid = True

        self.forward = max(
            -MAX_FORWARD,
            min(MAX_FORWARD, forward)
        )

        self.lateral = max(
            -MAX_LATERAL,
            min(MAX_LATERAL, lateral)
        )

        # NEVER allow vertical movement
        self.vertical = 0.0

    def set_zero_command(self):

        self.command_valid = False
        self.forward = 0.0
        self.lateral = 0.0
        self.vertical = 0.0

    # ========================================================
    # PX4 POSITION
    # ========================================================

    def position_callback(self, msg):

        self.position_x = msg.x
        self.position_y = msg.y
        self.position_z = msg.z

    # ========================================================
    # PX4 ATTITUDE
    # ========================================================

    def attitude_callback(self, msg):

        q = msg.q

        if len(q) < 4:
            return

        w = q[0]
        x = q[1]
        y = q[2]
        z = q[3]

        siny_cosp = 2.0 * (w * z + x * y)
        cosy_cosp = 1.0 - 2.0 * (y * y + z * z)

        self.heading = math.atan2(
            siny_cosp,
            cosy_cosp
        )

    # ========================================================
    # OFFBOARD HEARTBEAT
    # ========================================================

    def publish_offboard_mode(self):

        msg = OffboardControlMode()

        msg.timestamp = int(
            self.get_clock().now().nanoseconds / 1000
        )

        msg.position = False
        msg.velocity = True
        msg.acceleration = False
        msg.attitude = False
        msg.body_rate = False
        msg.thrust_and_torque = False
        msg.direct_actuator = False

        self.offboard_mode_pub.publish(msg)

    # ========================================================
    # TRAJECTORY SETPOINT
    # ========================================================

    def publish_setpoint(self):

        now = time.monotonic()

        # If NIDAR command is old, force zero.
        if (
            not self.command_valid
            or (now - self.last_command_time) > COMMAND_TIMEOUT
        ):
            forward = 0.0
            lateral = 0.0
        else:
            forward = self.forward
            lateral = self.lateral

        # ----------------------------------------------------
        # Body frame -> PX4 local NED
        #
        # forward = body forward
        # lateral = body right
        # vertical = disabled
        # ----------------------------------------------------

        yaw = self.heading

        north = (
            forward * math.cos(yaw)
            - lateral * math.sin(yaw)
        )

        east = (
            forward * math.sin(yaw)
            + lateral * math.cos(yaw)
        )

        # Vertical velocity MUST remain zero.
        down = 0.0

        msg = TrajectorySetpoint()

        msg.timestamp = int(
            self.get_clock().now().nanoseconds / 1000
        )

        # We are using velocity control.
        msg.position = [float('nan'), float('nan'), float('nan')]

        msg.velocity = [
            north,
            east,
            down
        ]

        msg.acceleration = [
            float('nan'),
            float('nan'),
            float('nan')
        ]

        msg.jerk = [
            float('nan'),
            float('nan'),
            float('nan')
        ]

        msg.yaw = yaw
        msg.yawspeed = 0.0

        self.trajectory_pub.publish(msg)

    # ========================================================
    # VEHICLE COMMAND
    # ========================================================

    def publish_vehicle_command(
        self,
        command,
        param1=0.0,
        param2=0.0,
        param3=0.0,
        param4=0.0,
        param5=0.0,
        param6=0.0,
        param7=0.0,
    ):

        msg = VehicleCommand()

        msg.timestamp = int(
            self.get_clock().now().nanoseconds / 1000
        )

        msg.command = command

        msg.param1 = param1
        msg.param2 = param2
        msg.param3 = param3
        msg.param4 = param4
        msg.param5 = param5
        msg.param6 = param6
        msg.param7 = param7

        msg.target_system = 1
        msg.target_component = 1

        msg.source_system = 1
        msg.source_component = 1

        msg.from_external = True
        msg.confirmation = 0

        self.vehicle_command_pub.publish(msg)

    # ========================================================
    # REQUEST OFFBOARD
    # ========================================================

    def request_offboard(self):

        # MAV_CMD_DO_SET_MODE = 176
        #
        # param1 = base mode
        # param2 = custom main mode
        #
        # PX4 custom main mode:
        # PX4_CUSTOM_MAIN_MODE_OFFBOARD = 6

        self.publish_vehicle_command(
            176,
            param1=1.0,
            param2=6.0
        )

        self.offboard_requested = True

        self.get_logger().info(
            'OFFBOARD REQUEST SENT'
        )

    # ========================================================
    # REQUEST ARM
    # ========================================================

    def request_arm(self):

        # MAV_CMD_COMPONENT_ARM_DISARM = 400

        self.publish_vehicle_command(
            400,
            param1=1.0
        )

        self.arm_requested = True

        self.get_logger().info(
            'ARM REQUEST SENT'
        )

    # ========================================================
    # CONTROL LOOP
    # ========================================================

    def control_loop(self):

        elapsed = time.monotonic() - self.start_time

        # ----------------------------------------------------
        # ALWAYS publish Offboard heartbeat
        # ----------------------------------------------------

        self.publish_offboard_mode()

        # ----------------------------------------------------
        # ALWAYS publish a velocity setpoint
        # ----------------------------------------------------

        self.publish_setpoint()

        # ----------------------------------------------------
        # Wait until PX4 has received heartbeat/setpoints.
        #
        # Then request Offboard.
        # ----------------------------------------------------

        if (
            ALLOW_OFFBOARD
            and not self.offboard_requested
            and elapsed > 3.0
        ):
            self.request_offboard()

        # ----------------------------------------------------
        # Arm only after Offboard request.
        # ----------------------------------------------------

        if (
            ALLOW_ARM
            and self.offboard_requested
            and not self.arm_requested
            and elapsed > 5.0
        ):
            self.request_arm()

        # ----------------------------------------------------
        # Status output
        # ----------------------------------------------------

        if int(elapsed * PUBLISH_HZ) % 10 == 0:

            age = (
                time.monotonic() - self.last_command_time
                if self.last_command_time > 0
                else 999.0
            )

            self.get_logger().info(
                f'CMD F={self.forward:+.3f} '
                f'L={self.lateral:+.3f} '
                f'V={self.vertical:+.3f} | '
                f'YAW={math.degrees(self.heading):+.1f}deg | '
                f'OFFBOARD={self.offboard_requested} | '
                f'ARM={self.arm_requested} | '
                f'AGE={age:.2f}s'
            )

    # ========================================================
    # SHUTDOWN
    # ========================================================

    def shutdown(self):

        self.get_logger().info(
            'Sending zero velocity before shutdown'
        )

        self.set_zero_command()

        for _ in range(5):

            self.publish_offboard_mode()
            self.publish_setpoint()

            rclpy.spin_once(
                self,
                timeout_sec=0.05
            )


def main(args=None):

    rclpy.init(args=args)

    node = PX4AirMouseController()

    try:
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:
        node.shutdown()
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
